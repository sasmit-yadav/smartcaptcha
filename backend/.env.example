# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Supabase pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Redis connection string (Phase 3.3)
REDIS_URL=

# Secret key for JWT/API key validation (Phase 3.1)
SECRET_KEY=

# Allowed CORS origins (Phase 3.4), comma-separated
ALLOWED_ORIGINS=

# Optional shared key for server-side telemetry ingestion (ml-train bots)
INGEST_API_KEY=
