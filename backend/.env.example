# PostgreSQL connection string (Phase 3.2)
# For local dev:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartcaptcha

# For production (e.g. Neon, Supabase, Railway):
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Redis connection string (Phase 3.3)
REDIS_URL=redis://localhost:6379

# Secret key for JWT/API key validation (Phase 3.1)
SECRET_KEY=your-random-64-character-secret-key-here

# Allowed CORS origins (Phase 3.4)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://demo.smartcaptcha.ai
