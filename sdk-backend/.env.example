# VeilProof API (sdk-backend)
# Production defaults to REQUEST_SIGNING_MODE=strict in code.
# Soft remains an emergency rollback only.

REQUEST_SIGNING_MODE=strict
# REQUEST_SIGNING_MODE=soft
# REQUEST_SIGNING_DISABLED=0

REQUEST_SIGNING_MAX_SKEW_SECONDS=120
REQUEST_SIGNING_UNSIGNED_READY=0.01
REQUEST_SIGNING_MIN_SAMPLES_READY=50

DATABASE_URL=
SECRET_KEY=
