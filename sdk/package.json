{
  "version": "1.1.8",
  "name": "veilproof",
  "description": "VeilProof behavioral telemetry SDK for bot detection",
  "main": "dist/veilproof.cjs.js",
  "module": "dist/veilproof.esm.js",
  "browser": "dist/veilproof.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/veilproof.esm.js",
      "require": "./dist/veilproof.cjs.js",
      "browser": "./dist/veilproof.min.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "npm run build:umd && npm run build:esm && npm run build:cjs && npm run build:ts",
    "build:umd": "esbuild ./src/index.ts --bundle --minify --outfile=dist/veilproof.min.js --format=iife",
    "build:esm": "esbuild ./src/index.ts --bundle --outfile=dist/veilproof.esm.js --format=esm",
    "build:cjs": "esbuild ./src/index.ts --bundle --outfile=dist/veilproof.cjs.js --format=cjs",
    "build:ts": "tsc",
    "dev": "esbuild ./src/index.ts --bundle --outfile=dist/veilproof.js --format=iife --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["captcha", "bot-detection", "behavioral-biometrics", "fraud-prevention", "telemetry"],
  "author": "VeilProof",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasmit-yadav/smartcaptcha.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/sasmit-yadav/smartcaptcha/issues"
  },
  "homepage": "https://github.com/sasmit-yadav/smartcaptcha/tree/main/sdk",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.21.0",
    "typescript": "^6.0.3"
  }
}
